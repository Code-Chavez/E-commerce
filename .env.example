# ========================================
# DATABASE (MariaDB)
# ========================================
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=e-commerce_db
DB_USER=e-commerce_user
DB_PASSWORD=e-commerce_pass

# ========================================
# SERVER (Backend)
# ========================================
# NODE_ENV indica el entorno de ejecución (ej. development, production, test)
NODE_ENV=development
SERVER_PORT=3000
BCRYPT_SALT_ROUNDS=12
VERIFICATION_PIN_EXPIRES_IN_HOURS=24
RESET_PASSWORD_TOKEN_EXPIRES_IN=1h
RESEND_API_KEY=re_1234567890_placeholder
RESEND_FROM_EMAIL=E-Commerce <noreply@e-commerce.shop>
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
SEED_ADMIN_EMAIL=admin_seed@domain.com
SEED_ADMIN_PASSWORD=set_your_own_secure_password_here
# RSK-003 / T-046+T-047: Comma-separated allowed IPs for admin routes.
# Leave empty to allow all (development). Example: 10.0.0.1,192.168.1.100
IP_WHITELIST=

# ========================================
# GOOGLE OAuth 2.0
# ========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ========================================
# CLOUDINARY
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========================================
# CLIENT (Frontend)
# ========================================
CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000/api

# ========================================
# FACTILIZA
# ========================================
FACTILIZA_TOKEN=factiliza_token

# ========================================
# STRIPE
# ========================================
STRIPE_SECRET_KEY=your_stripe_secret_key
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ========================================
# BACKUP (RSK-002)
# ========================================
RETENTION_DAYS=7
BACKUP_WEBHOOK_URL=http://server:3000
BACKUP_WEBHOOK_SECRET=your_strong_random_backup_secret